PROJECT_NAME           = "clif"
PROJECT_BRIEF          = "Command Line Interface (FORTH)"
PROJECT_LOGO           = doc/logo.png
OUTPUT_DIRECTORY       = doc
HTML_OUTPUT            = html
INPUT                  = README.md doc lib inc src hw cpu arch os
INCLUDE_PATH           = inc
INCLUDE_PATH          += hw/pc/inc cpu/i5/inc arch/x86_64/inc
INCLUDE_PATH          += lib/c/inc lib/core/inc lib/cli/inc
EXCLUDE                = ref/* *.pdf *.djvu
EXCLUDE               += hw/f4disco/Src hw/f4disco/Inc hw/f4disco/Drivers
WARN_IF_UNDOCUMENTED   = NO
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md
GENERATE_LATEX         = NO
FILE_PATTERNS         += *.lex *.yacc *.ragel *.rl
EXTENSION_MAPPING      = lex=C++ yacc=C++ ragel=C++ rl=C++ ino=C++
HAVE_DOT               = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PACKAGE        = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
EXTRACT_ANON_NSPACES   = YES
LAYOUT_FILE            = doc/DoxygenLayout.xml
SORT_GROUP_NAMES       = YES
REPEAT_BRIEF           = NO
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
